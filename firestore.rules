rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email in ['admin@digitalheroes.co.in', 'ranjanaayush48@gmail.com']);
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;

      // A newly authenticated user can create ONLY their own profile.
      allow create: if request.auth != null
                    && request.auth.uid == userId;

      // A user can update ONLY their own profile.
      // Prevent users from changing an existing role field.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && (
                      !('role' in resource.data)
                      || request.resource.data.role == resource.data.role
                    );

      allow delete: if isAdmin();

      match /scores/{scoreId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                      && (request.auth.uid == userId || isAdmin());
      }
    }

    // Subscriptions Collection
    // Users can read their own subscription record.
    // Writes are restricted to authenticated owners updating their own record or admins.
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Charities Collection (Public read, admin write)
    match /charities/{charityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Monthly Draws (Public read for published, admin full access)
    match /draws/{drawId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Winner verification & proof uploads
    match /winners/{winnerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
    }

    // Platform Configuration
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Donations
    match /donations/{donationId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
