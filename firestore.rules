rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email in ['admin@digitalheroes.co.in', 'ranjanaayush48@gmail.com'] ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow owner updates (profile details, charity selection) but prevent changing role
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // User golf scores subcollection (requires active subscription or admin)
      match /scores/{scoreId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Subscriptions Collection
    // Users can read their own subscription record.
    // Writes are restricted to authenticated owners updating their own record or admins.
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Charities Collection (Public read, admin write)
    match /charities/{charityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Monthly Draws (Public read for published, admin full access)
    match /draws/{drawId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Winner verification & proof uploads
    match /winners/{winnerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
    }

    // Platform Configuration
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Donations
    match /donations/{donationId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
